+use super::*;
+use pretty_assertions::assert_eq;
+use std::os::unix::fs::PermissionsExt;
+
+fn helper(script: &str) -> std::io::Result<(tempfile::TempDir, Config)> {
+    let directory = tempfile::tempdir()?;
+    let executable = directory.path().join("filter");
+    std::fs::write(&executable, format!("#!/bin/sh\n{script}\n"))?;
+    std::fs::set_permissions(&executable, std::fs::Permissions::from_mode(/*mode*/ 0o700))?;
+    Ok((
+        directory,
+        Config {
+            executable,
+            timeout: Duration::from_secs(/*secs*/ 3),
+        },
+    ))
+}
+fn request() -> Request {
+    let mut request = Request::new(
+        Method::POST,
+        "https://example.invalid/v1/responses".to_owned(),
+    );
+    request.headers.insert(
+        "session_id",
+        http::HeaderValue::from_static("synthetic-session"),
+    );
+    request.with_json(&json!({"input":"192.0.2.1"}))
+}
+#[test]
+fn completed_body_uses_only_validated_helper_output() {
+    let (_directory, config) = helper(
+        "cat >/dev/null; printf '%s' '{\"protocol\":\"sanctum-native-v1\",\"session_id\":\"synthetic-session\",\"body\":{\"input\":\"[IP-1]\"}}'",
+    ).unwrap();
+    let body = filter_with(&request(), &config).unwrap().unwrap();
+    let RequestBody::EncodedJson(body) = body else {
+        panic!("expected JSON body");
+    };
+    assert_eq!(
+        serde_json::from_slice::<Value>(body.as_bytes()).unwrap(),
+        json!({"input":"[IP-1]"})
+    );
+}
+#[test]
+fn wrong_protocol_or_session_never_returns_original_request() {
+    for output in [
+        "{}",
+        "{\"protocol\":\"sanctum-native-v1\",\"session_id\":\"other-session\",\"body\":{}}",
+    ] {
+        let (_directory, config) =
+            helper(&format!("cat >/dev/null; printf '%s' '{output}'")).unwrap();
+        assert_eq!(filter_with(&request(), &config).unwrap_err(), FAILURE);
+    }
+}
+#[test]
+fn helper_exit_timeout_and_opaque_body_fail_closed() {
+    for script in ["exit 1", "cat >/dev/null; sleep 1"] {
+        let (_directory, mut config) = helper(script).unwrap();
+        config.timeout = Duration::from_millis(/*millis*/ 100);
+        assert_eq!(filter_with(&request(), &config).unwrap_err(), FAILURE);
+    }
+    let (_directory, config) = helper("exit 0").unwrap();
+    let mut opaque = request();
+    opaque.body = Some(RequestBody::Raw(bytes::Bytes::from_static(b"opaque")));
+    assert_eq!(filter_with(&opaque, &config).unwrap_err(), FAILURE);
+}
+#[test]
+fn unrelated_model_listing_preserves_request_without_helper_call() {
+    let (_directory, config) = helper("exit 1").unwrap();
+    let request = Request::new(Method::GET, "https://example.invalid/v1/models".to_owned());
+    assert_eq!(filter_with(&request, &config).unwrap(), None);
+}
