+++ b/codex-rs/http-client/src/sanctum_http.rs
@@ -0,0 +1,336 @@
+use crate::request::EncodedJsonBody;
+use crate::request::Request;
+use crate::request::RequestBody;
+use http::Method;
+use serde_json::Value;
+use serde_json::json;
+use std::io::Read;
+use std::io::Write;
+use std::path::PathBuf;
+use std::process::Command;
+use std::process::Stdio;
+use std::time::Duration;
+use std::time::Instant;
+
+const LIMIT: usize = 8 * 1024 * 1024;
+const PROTOCOL: &str = "sanctum-native-v1";
+const FAILURE: &str =
+    "Sanctum blocked model request: local privacy filtering failed; content omitted";
+
+pub(crate) struct Config {
+    pub(crate) executable: PathBuf,
+    pub(crate) timeout: Duration,
+}
+impl Config {
+    fn from_env() -> Result<Option<Self>, String> {
+        let helper = std::env::var_os("SANCTUM_NATIVE_HELPER");
+        if helper.is_none() && std::env::var_os("SANCTUM_NATIVE_REQUIRED").is_none() {
+            return Ok(None);
+        }
+        let executable = helper
+            .map(PathBuf::from)
+            .ok_or_else(|| FAILURE.to_owned())?;
+        if !executable.is_absolute() {
+            return Err(FAILURE.to_owned());
+        }
+        Ok(Some(Self {
+            executable,
+            timeout: Duration::from_secs(  15),
+        }))
+    }
+}
+
+pub(crate) fn filter(req: &Request) -> Result<Option<RequestBody>, String> {
+    let config = match Config::from_env() {
+        Ok(config) => config,
+        Err(_) => return fallback(req),
+    };
+    match config {
+        Some(config) => filter_with(req, &config),
+        None => Ok(None),
+    }
+}
+
+pub(crate) fn filter_with(req: &Request, config: &Config) -> Result<Option<RequestBody>, String> {
+    inspect_with(req, config).or_else(|_| fallback(req))
+}
+
+fn fallback(req: &Request) -> Result<Option<RequestBody>, String> {
+    let url = reqwest::Url::parse(&req.url).map_err(|_| FAILURE.to_owned())?;
+    let path = url.path();
+    if !path.split('/').any(|part| part == "responses")
+        && !path.ends_with("/memories/trace_summarize")
+        && !path.ends_with("/search")
+    {
+        return Ok(None);
+    }
+    let mut body = json!({"instructions":"Context unavailable. Respond briefly.","input":[{"role":"user","content":[{"type":"input_text","text":"[SANCTUM-REDACTED: content could not be masked]"}]}],"store":false});
+    if path.ends_with("/memories/trace_summarize") {
+        body = json!({"raw_memories":[]});
+    } else if path.ends_with("/responses/compact")
+        && let Some(map) = body.as_object_mut()
+    {
+        map.remove("store");
+    }
+    let source = match req.body.as_ref() {
+        Some(RequestBody::Json(value)) => Some(value.clone()),
+        Some(RequestBody::EncodedJson(value)) if value.as_bytes().len() <= LIMIT => {
+            serde_json::from_slice(value.as_bytes()).ok()
+        }
+        _ => None,
+    };
+    if let Some(model) = source.as_ref().and_then(|value| value.get("model"))
+        && model.as_str().is_some_and(|s| {
+            !s.is_empty()
+                && s.len() <= 256
+                && s.bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || b"_.:/-".contains(&c))
+        })
+    {
+        body["model"] = model.clone();
+    }
+    if let Some(stream) = source
+        .as_ref()
+        .and_then(|value| value.get("stream"))
+        .filter(|v| v.is_boolean())
+    {
+        body["stream"] = stream.clone();
+    }
+    if let Some(reasoning) = source
+        .as_ref()
+        .and_then(|value| value.get("reasoning"))
+        .filter(|v| v.is_object())
+    {
+        let mut safe = serde_json::Map::new();
+        for (key, options) in [
+            (
+                "effort",
+                &[
+                    "none",
+                    "minimal",
+                    "low",
+                    "medium",
+                    "high",
+                    "xhigh",
+                    "max",
+                    "ultra",
+                    "persistent",
+                ][..],
+            ),
+            ("summary", &["auto", "concise", "detailed", "none"][..]),
+            (
+                "context",
+                &["all_turns", "last_turn", "auto", "current_turn"][..],
+            ),
+        ] {
+            if let Some(value) = reasoning
+                .get(key)
+                .filter(|v| v.is_null() || v.as_str().is_some_and(|s| options.contains(&s)))
+            {
+                safe.insert(key.to_owned(), value.clone());
+            }
+        }
+        body["reasoning"] = Value::Object(safe);
+    }
+    if let Some(limit) = source
+        .as_ref()
+        .and_then(|value| value.get("max_output_tokens"))
+        .filter(|v| v.is_u64() || v.is_null())
+    {
+        body["max_output_tokens"] = limit.clone();
+    }
+    if let Some(parallel) = source
+        .as_ref()
+        .and_then(|value| value.get("parallel_tool_calls"))
+        .filter(|v| v.is_boolean())
+    {
+        body["parallel_tool_calls"] = parallel.clone();
+    }
+    ensure_lite_context(req, &mut body);
+    Ok(Some(RequestBody::EncodedJson(
+        EncodedJsonBody::encode(&body).map_err(|_| FAILURE.to_owned())?,
+    )))
+}
+
+fn inspect_with(req: &Request, config: &Config) -> Result<Option<RequestBody>, String> {
+    let url = reqwest::Url::parse(&req.url).map_err(|_| FAILURE.to_owned())?;
+    let path = url.path();
+    let model_context = path.split('/').any(|part| part == "responses")
+        || path.ends_with("/memories/trace_summarize")
+        || path.ends_with("/search");
+    if !model_context {
+        return Ok(None);
+    }
+    if req.method != Method::POST {
+        return Err(FAILURE.to_owned());
+    }
+    let session = req
+        .headers
+        .get("session_id")
+        .or_else(|| req.headers.get("x-client-request-id"))
+        .and_then(|h| h.to_str().ok())
+        .filter(|s| !s.is_empty())
+        .ok_or_else(|| FAILURE.to_owned())?;
+    let body = match req.body.as_ref() {
+        Some(RequestBody::Json(body)) => body.clone(),
+        Some(RequestBody::EncodedJson(body)) => {
+            if body.as_bytes().len() > LIMIT {
+                return Err(FAILURE.to_owned());
+            }
+            serde_json::from_slice(body.as_bytes()).map_err(|_| FAILURE.to_owned())?
+        }
+        Some(RequestBody::Raw(_)) | None => return Err(FAILURE.to_owned()),
+    };
+    let request_kind = if path.ends_with("/responses/compact") {
+        "compact"
+    } else {
+        "context"
+    };
+    let input =
+        serde_json::to_vec(&json!({"session_id":session,"request_kind":request_kind,"request_id":req.headers.get("x-sanctum-local-request").and_then(|h|h.to_str().ok()),"body":body}))
+            .map_err(|_| FAILURE.to_owned())?;
+    if input.len() > LIMIT {
+        return Err(FAILURE.to_owned());
+    }
+    let output = invoke(config, "model-request", input)?;
+    let result: Value = serde_json::from_slice(&output).map_err(|_| FAILURE.to_owned())?;
+    if result["protocol"] != PROTOCOL
+        || result["session_id"] != session
+        || !result["body"].is_object()
+    {
+        return Err(FAILURE.to_owned());
+    }
+    let mut filtered = result["body"].clone();
+    ensure_lite_context(req, &mut filtered);
+    Ok(Some(RequestBody::EncodedJson(
+        EncodedJsonBody::encode(&filtered).map_err(|_| FAILURE.to_owned())?,
+    )))
+}
+
+fn ensure_lite_context(req: &Request, body: &mut Value) {
+    if req
+        .headers
+        .get("x-openai-internal-codex-responses-lite")
+        .is_some_and(|value| value == "true")
+    {
+        if !body.get("reasoning").is_some_and(Value::is_object) {
+            body["reasoning"] = json!({});
+        }
+        body["reasoning"]["context"] = json!("all_turns");
+        body["parallel_tool_calls"] = json!(false);
+
+        if let Some(instructions) = body
+            .as_object_mut()
+            .and_then(|map| map.remove("instructions"))
+            && instructions.as_str().is_some_and(|text| !text.is_empty())
+        {
+            let input = body["input"].take();
+            let mut items = match input {
+                Value::Array(items) => items,
+                Value::String(text) => vec![json!({"role":"user","content":text})],
+                _ => Vec::new(),
+            };
+            items.insert(
+                0,
+                json!({"role":"developer","content":[{"type":"input_text","text":instructions}]}),
+            );
+            body["input"] = Value::Array(items);
+        }
+    }
+}
+
+pub fn record_sanctum_provider_item(
+    session: &str,
+    request: &str,
+    item: &Value,
+) -> Result<(), String> {
+    let Some(config) = Config::from_env()? else {
+        return Ok(());
+    };
+    if !matches!(
+        item["type"].as_str(),
+        Some("reasoning" | "compaction" | "compaction_summary" | "context_compaction")
+    ) || !item["encrypted_content"].is_string()
+    {
+        return Ok(());
+    }
+    let input = serde_json::to_vec(&json!({"session_id":session,"request_id":request,"item":item}))
+        .map_err(|_| FAILURE.to_owned())?;
+    if input.len() > LIMIT {
+        return Err(FAILURE.to_owned());
+    }
+    let output = invoke(&config, "provider-item", input)?;
+    let result: Value = serde_json::from_slice(&output).map_err(|_| FAILURE.to_owned())?;
+    if result["protocol"] != PROTOCOL
+        || result["session_id"] != session
+        || result["recorded"] != true
+    {
+        return Err(FAILURE.to_owned());
+    }
+    Ok(())
+}
+
+fn invoke(config: &Config, action: &str, input: Vec<u8>) -> Result<Vec<u8>, String> {
+    let mut child = Command::new(&config.executable)
+        .arg(action)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .spawn()
+        .map_err(|_| FAILURE.to_owned())?;
+    let mut stdin = child.stdin.take().ok_or_else(|| FAILURE.to_owned())?;
+    let stdout = child.stdout.take().ok_or_else(|| FAILURE.to_owned())?;
+    let (send, receive) = std::sync::mpsc::channel();
+    let writer = send.clone();
+    std::thread::spawn(move || {
+        let result = stdin.write_all(&input).map(|()| None).map_err(|_| ());
+        drop(stdin);
+        let _ = writer.send(result);
+    });
+    std::thread::spawn(move || {
+        let mut output = Vec::new();
+        let result = stdout
+            .take((LIMIT + 1) as u64)
+            .read_to_end(&mut output)
+            .map_err(|_| ())
+            .and({
+                if output.len() > LIMIT {
+                    Err(())
+                } else {
+                    Ok(Some(output))
+                }
+            });
+        let _ = send.send(result);
+    });
+    let deadline = Instant::now() + config.timeout;
+    let outcome = (|| {
+        let status = loop {
+            match child.try_wait() {
+                Ok(Some(status)) => break status,
+                Ok(None) if Instant::now() < deadline => {
+                    std::thread::sleep(Duration::from_millis(  5))
+                }
+                Ok(None) | Err(_) => return Err(FAILURE.to_owned()),
+            }
+        };
+        if !status.success() {
+            return Err(FAILURE.to_owned());
+        }
+        let mut output = None;
+        for _ in 0..2 {
+            let result = receive
+                .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+                .map_err(|_| FAILURE.to_owned())?
+                .map_err(|_| FAILURE.to_owned())?;
+            if let Some(bytes) = result {
+                output = Some(bytes);
+            }
+        }
+        output.ok_or_else(|| FAILURE.to_owned())
+    })();
+    if outcome.is_err() {
+        let _ = child.kill();
+    }
+    let _ = child.wait();
+    outcome
+}
