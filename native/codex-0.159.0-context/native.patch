diff --git a/codex-rs/codex-api/src/sanctum_stream.rs b/codex-rs/codex-api/src/sanctum_stream.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/codex-api/src/sanctum_stream.rs
@@ -0,0 +1,66 @@
+use crate::common::ResponseEvent;
+use crate::common::ResponseStream;
+use crate::error::ApiError;
+use futures::StreamExt;
+use tokio::sync::mpsc;
+
+pub(crate) fn observe(
+    mut stream: ResponseStream,
+    session: Option<String>,
+    request: String,
+) -> Result<ResponseStream, ApiError> {
+    if std::env::var_os("SANCTUM_NATIVE_HELPER").is_none()
+        && std::env::var_os("SANCTUM_NATIVE_REQUIRED").is_none()
+    {
+        return Ok(stream);
+    }
+    let Some(session) = session else {
+        return Ok(stream);
+    };
+    let upstream_request_id = stream.upstream_request_id.take();
+    let interrupt = stream.interrupt.take();
+    let (tx_event, rx_event) = mpsc::channel(  16);
+    tokio::spawn(async move {
+        while let Some(event) = stream.next().await {
+            if let Ok(ResponseEvent::OutputItemDone(item)) = &event {
+                let item = match serde_json::to_value(item) {
+                    Ok(item) => item,
+                    Err(_) => {
+                        let _ = tx_event
+                            .send(Err(ApiError::Stream(
+                                "Sanctum: provider item could not be inspected".to_owned(),
+                            )))
+                            .await;
+                        return;
+                    }
+                };
+                if matches!(
+                    item["type"].as_str(),
+                    Some("reasoning" | "compaction" | "compaction_summary" | "context_compaction")
+                ) && item["encrypted_content"].is_string()
+                {
+                    let session = session.clone();
+                    let request = request.clone();
+                    let recorded = tokio::task::spawn_blocking(move || {
+                        codex_http_client::record_sanctum_provider_item(&session, &request, &item)
+                    })
+                    .await;
+                    if !matches!(recorded, Ok(Ok(())))
+                        && std::env::var_os("SANCTUM_CONTEXT_PROTECTION").is_none_or(|v| v != "1")
+                    {
+                        let _=tx_event.send(Err(ApiError::Stream("Sanctum: provider reasoning could not be registered; content omitted".to_owned()))).await;
+                        return;
+                    }
+                }
+            }
+            if tx_event.send(event).await.is_err() {
+                return;
+            }
+        }
+    });
+    Ok(ResponseStream {
+        rx_event,
+        upstream_request_id,
+        interrupt,
+    })
+}
